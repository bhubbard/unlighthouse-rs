{
  "name": "@unlighthouse/monorepo",
  "type": "module",
  "version": "0.17.9",
  "private": true,
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "license": "MIT",
  "scripts": {
    "cli": "./packages/core-rs/target/debug/unlighthouse-rs --lighthouse-process-path ./packages/core-rs/lighthouse.mjs",
    "dev:rs": "./dev-rs.sh",
    "ci": "./packages/core-rs/target/debug/unlighthouse-rs --lighthouse-process-path ./packages/core-rs/lighthouse.mjs",
    "build": "pnpm run build:pkg",
    "build:docs": "cd docs && pnpm i && nuxi build",
    "build:pkg": "pnpm -r --filter='./packages/**' run build",
    "stub": "JITI_ESM_RESOLVE=true && pnpm -r --parallel run stub",
    "lint": "eslint . --fix",
    "bump": "bumpp package.json packages/*/package.json --commit --push --tag",
    "release": "pnpm build && pnpm bump",
    "test": "vitest --exclude test/ci.test.ts",
    "test:e2e": "vitest run test/ci.test.ts",
    "test:update": "vitest -u",
    "docs": "npm -C docs run dev",
    "docs:build": "npm -C docs run build",
    "docs:serve": "npm -C docs run serve",
    "test:attw": "pnpm -r run test:attw",
    "lint:docs": "pnpx markdownlint-cli ./docs && pnpx case-police 'docs/**/*.md' *.md",
    "lint:docs:fix": "pnpx markdownlint-cli ./docs --fix && pnpx case-police 'docs/**/*.md' *.md --fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@arethetypeswrong/cli": "catalog:",
    "bumpp": "catalog:",
    "chrome-remote-interface": "catalog:",
    "eslint": "catalog:",
    "obuild": "catalog:",
    "puppeteer": "catalog:",
    "tinyexec": "catalog:dependencies",
    "typescript": "catalog:",
    "vite": "catalog:dependencies",
    "vitest": "catalog:"
  }
}
